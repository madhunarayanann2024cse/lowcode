		workflow
		{
		form
		{
			auto_assign_investigator as "Auto-Assign Investigator by Claim Type"
			{
				type =  form
				form = claim_request

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the claims team records to build a mapping of specialization to investigator IDs
										claimsTeamRecords = claims_team[ID != 0];
										// Initialize a map to store specialization to investigator ID mapping
										investigatorMap = Map();
										// Iterate through claims team to build the mapping
										for each  teamMember in claimsTeamRecords
										{
											// Get the specialization of the team member
											specialization = teamMember.specialization;
											// Check if specialization is not null or empty
											if(!specialization.isNull() && !specialization.isEmpty())
											{
												// Store the investigator ID for this specialization
												investigatorMap.put(specialization,teamMember.ID);
											}
										}
										// Get the claim type from input
										claimType = input.claim_type;
										// Initialize investigator ID variable
										investigatorID = null;
										// Check if claim type is not null or empty
										if(!claimType.isNull() && !claimType.isEmpty())
										{
											// Check if the claim type exists in the investigator map
											if(investigatorMap.containKey(claimType))
											{
												// Get the investigator ID for the claim type
												investigatorID = investigatorMap.get(claimType);
											}
										}
										// Assign the investigator to the assigned_investigator field if found
										if(!investigatorID.isNull())
										{
											input.assigned_investigator = investigatorID;
										}
										// Enable the assigned_investigator field
										enable assigned_investigator;
						)
					}
				}

			}
			validate_claim_amount_docs as "Validate Claim Amount and Documents"
			{
				type =  form
				form = claim_request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if claim amount exceeds the limit (assuming limit is 100000)
										if(input.claim_amount_requested > 100000)
										{
											alert "Claim amount exceeds the maximum limit of 100000. Please reduce the amount.";
											cancel submit;
										}
										// Check if supporting documents are available
										if(input.supporting_documents_available.size() == 0)
										{
											alert "Please upload at least one supporting document (Police FIR, Photographs, Medical Reports, Repair Estimate, or Other).";
											cancel submit;
										}
						)
					}
				}

			}
		}





 application "Bank Loan Application"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Bank_Loan_Application
		{
			displayname = "Bank Loan Application"
			success message = "Data Added Successfully!"
			Section_A_Personal_Details
			(
				type = section
				displayname = "Section A — Personal Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Applicant_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Date_Of_Birth
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			PAN_Number
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Section_B_Contact_Details
			(
				type = section
				displayname = "Section B — Contact Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have unique Email_Address
			(
    			type = email
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Residential_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have unique Contact_Number
			(
    			type = phonenumber
    			defaultcountry="in"
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Section_C_Income_Employment_Details
			(
				type = section
				displayname = "Section C — Income & Employment Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Employment_Type
			(
				type = radiobuttons
				maxchar = 100
				values = {"salaried","self_employed_professional","self_employed_business"}
				sortorder = ascending
				others option = true
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Monthly_Income
			(
				type = number
				displayname = "Monthly Income"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Existing_Liabilities
			(
				type = list	
				displayname = "Existing Liabilities"
				values = {"Credit card Dues","Car Loan","Student Loan"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section_D_Loan_Details_Consent
			(
				type = section
				displayname = "Section D — Loan Details & Consent"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Loan_Type
			(
				type = picklist
				displayname = "Loan Type"
				maxchar = 100
				values = {"Car Loan","House Loan","Gold Loan"}
				sortorder = ascending
				others option = true
	 			row = 4
	 			column = 1   
				width = medium
			)
			Purpose_of_Loan
			(
    			type = textarea
				displayname = "Purpose of Loan"
				height = 100px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Preferred_Callback_Time
			(
    			type = time
				displayname = "Preferred Callback Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have I_consent_to_a_credit_bureau_check
			(
				type = checkboxes	
				displayname = "I consent to a credit bureau check"
				values = {"Yes, I authorize a credit check","Provided informations are True"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Section_E_Branch_Verification_KYC
			(
				type = section
				displayname = "Section E — Branch Verification & KYC"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Bank_Loan_Application
			(
				type = picklist	
				displayname = "Bank Loan Application"
				values  = Bank_Loan_Application.ID
    			displayformat = [PAN_Number]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Applicant_Photo
			(
    			type = image
				displayname = "Applicant Photo"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Income_Proof_Upload
			(
    			type = upload file
				displayname = "Income Proof Upload"
				browse = local_drive
				allowed file formats = {"pdf","jpg","png"}
	 			row = 5
	 			column = 1   
				width = medium
			)
			Debt_to_Income_Ratio
			(
				type = decimal
				displayname = "Debt-to-Income Ratio"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Section_F_Joint_Application_Media_Details
			(
				type = section
				displayname = "Section F — Joint Application & Media Details"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Property_Listing_URL
			(
    			type = url
				displayname = "Property Listing URL"
				enable  linkname
	 			row = 6
	 			column = 1   
				width = medium
			)
			Property_Video_Walkthrough
			(
    			type = video
				displayname = "Property Video Walkthrough"
    			duration=30
	 			row = 6
	 			column = 1   
				width = medium
			)
			Loan_Purpose_Voice_Note
			(
     			type = audio
				displayname = "Loan Purpose Voice Note"
    			duration=60
	 			row = 6
	 			column = 1   
				width = medium
			)
			Co_Applicant_Details
			(
				type = grid
				displayname = "Co-Applicant Details"
				co_applicant_name
				(
    				type = name
					displayname = "co-applicant name"
     				prefix
     				(
	     				 type = prefix
	     				 displayname ="Prefix"
	     				 visibility = false
	     				 value = {"Mr.","Mrs.","Ms."}
     				) 
     				first_name
     				(
	     				 type = first_name
	     				 displayname ="First Name"
     				) 
     				last_name
     				(
	     				 type = last_name
	     				 displayname ="Last Name"
     				) 
     				suffix
     				(
	     				 type = suffix
	     				 displayname ="Suffix"
	     				 visibility = false
     				) 
					width = medium
					personal data = true
				)
				Name
				(
    				type = name
     				prefix
     				(
	     				 type = prefix
	     				 displayname ="Prefix"
	     				 visibility = false
	     				 value = {"Mr.","Mrs.","Ms."}
     				) 
     				first_name
     				(
	     				 type = first_name
	     				 displayname ="First Name"
     				) 
     				last_name
     				(
	     				 type = last_name
	     				 displayname ="Last Name"
     				) 
     				suffix
     				(
	     				 type = suffix
	     				 displayname ="Suffix"
	     				 visibility = false
     				) 
					width = medium
					personal data = true
				)
	 			row = 7
	 			column = 1   
				width = medium
			)
			SectionSectionSection_G_Loan_Terms_EMI_Computation
			(
				type = section
				displayname = "SectionSectionSection G — Loan Terms & EMI Computation"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			must have Has_Existing_Loan_With_Bank
			(
    			type = checkbox
				displayname = "Has Existing Loan With Bank"
				initial value = false
	 			row = 8
	 			column = 1   
				width = medium
			)
			Loan_Amount_Requested
			(
				displayname = "Loan Amount Requested"
				type = INR
				format = commadotindian
	 			row = 8
	 			column = 1   
				width = medium
			)
			Interest_Rate_Offered
			(
    			type = percentage
				displayname = "Interest Rate Offered"
	 			row = 8
	 			column = 1   
				width = medium
			)
			Estimated_Monthly_EMI
			(
				type = decimal
	 			row = 8
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  (input.Loan_Amount_Requested * input.Interest_Rate_Offered) / (12 * input.Application_Submitted_On)
    						visibility = false
    			)
			)
			SectionSection_G_Loan_Terms_EMI_Computation
			(
				type = section
				displayname = "Section H — Declaration & System-Generated Values"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Loan_Terms_Display
			(
    			type = richtext
				displayname = "Loan Terms Display"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 9
	 			column = 1   
				width = medium
			)
			Application_Submitted_On
			(
    			type = datetime
				displayname = "Application Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 9
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Application Tracking QR Code"
				value = "BNK-LN- ${zoho.currentdate}${Loan_Application_ID}"
	 			row = 9
	 			column = 2   
				width = medium
			)
			Loan_Application_ID
			(
    			type = autonumber
				displayname = "Loan Application ID"
				start index = 1
	 			row = 9
	 			column = 3   
				width = medium
			)
			must have Applicant_Digital_Signature
			(
    			type = signature
				displayname = "Applicant Digital Signature"
	 			row = 9
	 			column = 3   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Document Verification","Credit Check","Loan Approval","Created form","Loan Rejected"}
			}

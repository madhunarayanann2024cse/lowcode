				}
			}
		}
	}
	reports
	{
		default list Bank_Loan_Application_Report
		{
			displayName = "Bank Loan Application Report"
			print template = sample
			show all rows from Bank_Loan_Application    
			(
				Email_Address
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Applicant_Name 
				Date_Of_Birth
				PAN_Number
				Employment_Type
				Monthly_Income as "Monthly Income"
				Existing_Liabilities as "Existing Liabilities"
				Loan_Type as "Loan Type"
				Purpose_of_Loan as "Purpose of Loan"
				Preferred_Callback_Time as "Preferred Callback Time"
				I_consent_to_a_credit_bureau_check as "I consent to a credit bureau check"
				Applicant_Photo as "Applicant Photo"
				Income_Proof_Upload as "Income Proof Upload"
				Debt_to_Income_Ratio as "Debt-to-Income Ratio"
				Property_Listing_URL as "Property Listing URL"
				Co_Applicant_Details.co_applicant_name as "Co-Applicant Details"
				Property_Video_Walkthrough as "Property Video Walkthrough"
				Loan_Purpose_Voice_Note as "Loan Purpose Voice Note"

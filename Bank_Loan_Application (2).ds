	pages
	{
		page dashboard
		{
			displayname = "dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<panel elementName='Command_Center_Main_Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Bank_Loan_Application.Application_Submitted_On.distinctCount'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'total Loan Applicants'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<search \n\telementName='Search'\n\tpaddingTop = '40px'\n\tpaddingLeft = '80px'\n\tpaddingRight = '80px'\n\tpaddingBottom = '40px'\n\tbgtype = 'none'\n\tbgColor = '#FFFFFF'\n\n\tshape = 'rounded'\n\tresultComponent = 'report'\n\tlinkName = 'Bank_Loan_Application_Report'\n\ttarget = 'same-window'\n\tcriteriaString = 'Applicant_Name.last_name == input.searchString &amp;&amp; Loan_Application_ID == input.searchString'\n\tfontFamily = 'default'\n\tallowPublicAccess = 'true'\n\tappLinkName = 'thisapp'\n\tstyle = '4'\n\tplaceholder = 'Enter value'\n\n>\n<searchbar color=\"#000000\" bgColor=\"#FFFFFF\" fontSize=\"15px\"\n/><searchbutton color=\"#FFFFFF\" bgColor=\"#0072F4\" \nfontSize=\"15px\"  /></search>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<board\n    \n\tbgColor = '#FFFFFF'\n        bgColorType = 'solid'\n\tpadding = '0px'\nelementName='Loan_Status_Board'\n    layoutType = 'grid'\n        items = '1'\n    appLinkName = 'thisapp'\n    formLinkName = 'Bank_Loan_Application'\n    rankBy = 'ID'\n    rankOrder = 'highestToLowest'\n    rankAggregate = 'count'\n    limit = '3'\n    groupBy = 'Loan_Type'\n>\n<boardHeader>\n    <pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '14px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '14px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '17px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Types of loan'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</boardHeader>\n<boardLayout\n                paddingRight = '15px'\n                paddingBottom = '14px'\n                paddingLeft = '15px'\n                paddingTop = '2px'\n                itemGap = '10px'\n>\n    <pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingLeft = '20px'\n\tpaddingRight = '20px'\n\n    borderColor = '#F2F2F2'\n    borderWidth = '1px'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '12px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '10px'\n\tpaddingBottom = '10px'\n\n\t\twidth = '70%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#000000'\n\tsize = '19px'\n\tbold = 'true' \n\ttype = 'boardData'\n\n\n    lineHeight = '26'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'rank'\n>\n</text>\n\n</pc><pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '20px'\n\n\tcolor = '#000000'\n\tbgColor = '#F7F7FB'\n\twidth = '36px'\n\theight = '36px'\n\ttype = 'icon'\n\tvalue = 'education-books-46'\n\tsize = '20px'\n\tcornerRadius = '18px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n>\n\t<text \n\n\tmarginLeft = '15px'\n\tcolor = '#000000'\n\tsize = '16px'\n\ttype = 'boardData'\n\n\n    lineHeight = '22'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'groupedField'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\tpaddingTop = '10px'\n\tpaddingBottom = '10px'\n\n\t\twidth = '30%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = 'theme'\n\tsize = '17px'\n\tbold = 'true' \n\ttype = 'boardData'\n\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'rankAggregate'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</boardLayout>\n</board>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='LoanType_Distribution_Chart_Widget'\n\n\ttype = 'Pie'\n\txtitle = 'Loan per person'\n\tytitle = 'Application per person'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'right.center'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Bank_Loan_Application'\n\txfield = 'Loan_Type'\n\tyfields = 'value:Application_Submitted_On'\n\tshowDataLabel = 'true'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<gauge \n\telementName='Monthly_Disbursal_Target_Gauge'\n\n\tcolor = '#000000'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = '#FF7B19'\n\tdisplayType = 'actual'\n\ttype = '4'\n\tfilledColor = '#FF7B19'\n\tnonFilledColor = '#F5F5F5'\n\tvalue = 'thisapp.Bank_Loan_Application.Purpose_of_Loan.distinctCount'\n>\n<maximumvalue size=\"15px\" color=\"#7F7F7F\" value=\"1\" \n/>\n</gauge>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<form \n\telementName='Quick_Counter_Loan_Intake_Form'\n\n\tappLinkName = 'thisapp'\n\tlinkName = 'Bank_Loan_Application'\n\theightType = 'auto'\n\turlType = 'form'\n\t\turlAppLinkName = 'thisapp'\n\t\tzc_NextUrl = '#Form:Bank_Loan_Application'\n\t\tzc_OpenUrlIn = 'new window'\n\tzc_SuccMsg = 'Your Application is being viewed '\n\tzc_ResetVal = 'Reset'\n\tzc_Header = 'false'\n\tzc_SubmitVal = 'Submit'\n/> \n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Full_Loan_Applications_Report'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Loan_Applications_Spreadsheet'\n\t\ttarget = 'new-window'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n\ttext ='Full_Loan_Applications_Report'\n\t\tbgColor = '#0072F4'\n\t\tcornerRadius = '3px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<embed \n\telementName='Embed'\n\n\thAlign = 'center'\n\turl = 'https://creator.zoho.in/appbuilder/jaayish.ev.2024.cse_rajal817/bank-loan-application/pagebuilder/dashboard/edit'\n\twidth = '300'\n\theight = '150'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Send_Document_Reminder_Button'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\tvAlign = 'middle'\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenForm'\n\t\tparameters = 'Missing Details' \n\t\tcomponentLinkName = 'Bank_Loan_Application'\n\t\ttarget = 'new-window'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n\ttext ='Reminder'\n\t\tbgColor = 'theme'\n\t\tcornerRadius = '60px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			Send_Email_Form_Propertie as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Bank_Loan_Application
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address
							subject : "Bank Loan Application : New entry added"
							message : "<div>Hello ${Applicant_Name},<br><br>A new entry added in 'Bank_Loan_Application' form of Bank Loan Application application.<br></div>"
						)
					}
				}
			}
			On_Application_Submit_Wor as "On_Application_Submit_Workflow"
			{
				type =  form
				form = Bank_Loan_Application

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address
							subject : "Record Added"
							message : "<div>${zoho.loginuserid} has added a record in form Bank Loan Application<br></div>"
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Pending_Document_Re as "Daily_Pending_Document_Reminder_Schedule"
			{
				type =  schedule
					status = inactive
				start = "2026-08-21 16:18:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "jaayish.ev.2024.cse@rajalakshmi.edu.in"
							subject : "Task"
							message : "<div>${zoho.adminuserid} Select the applicants<br></div>"
							attachments : view : All_Loan_Applications_List as PDF
						)
					}
					actions 
					{
					on load
					(
						sendmail
										[
											from :zoho.loginuserid
											to :zoho.loginuser
											subject :"Attach the missing Document"
											message :"<div>" + zoho.loginuserid + "<br></div>"
										]
					)
					}
				}
			}
		}

		approval
		{
			HighValue_Loan_Approval as "HighValue_Loan_Approval"
			{
				type =  approval
				form = Bank_Loan_Application
				display fields = [Applicant_Name,Date_Of_Birth,PAN_Number,Email_Address,Residential_Address,Contact_Number,Employment_Type]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions  (Loan_Amount_Requested > 1000)
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "<div>Your request has been rejected.<br></div>"
							)
						}
					}
				}
			}
		}

